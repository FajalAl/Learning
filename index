<script>
  // ── COUNTDOWN CLOCK (EAT = UTC+3) ──────────────────────────────
  function updateClock() {
    // Deadline: March 20, 2026, 23:59:59 EAT (UTC+3)
    const deadlineEAT = new Date('2026-03-20T23:59:59+03:00').getTime();
    const nowEAT = Date.now(); // JS Date.now() is UTC, same epoch
    const diff = deadlineEAT - nowEAT;

    if (diff <= 0) {
      document.getElementById('cd-days').textContent = '00';
      document.getElementById('cd-hours').textContent = '00';
      document.getElementById('cd-mins').textContent = '00';
      document.getElementById('cd-secs').textContent = '00';
      return;
    }

    const days  = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const mins  = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const secs  = Math.floor((diff % (1000 * 60)) / 1000);

    document.getElementById('cd-days').textContent  = String(days).padStart(2,'0');
    document.getElementById('cd-hours').textContent = String(hours).padStart(2,'0');
    document.getElementById('cd-mins').textContent  = String(mins).padStart(2,'0');
    document.getElementById('cd-secs').textContent  = String(secs).padStart(2,'0');
  }
  updateClock();
  setInterval(updateClock, 1000);

  // ── CHECKOUT LOG ───────────────────────────────────────────────
  const STORAGE_KEY = 'life_system_checkout_v1';
  let currentWeek = 'week1';

  const weekLabels = {
    week1: 'Week 1 · March 7–13',
    week2: 'Week 2 · March 14–20',
    week3: 'Week 3 · March 21–27',
    week4: 'Week 4 · March 28 – April 3',
    week5: 'Week 5 · April 4+'
  };

  function getStore() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }
    catch(e) { return {}; }
  }
  function setStore(data) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch(e) {}
  }

  function switchWeek(week, btn) {
    currentWeek = week;
    document.querySelectorAll('.week-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('checkout-date-label').textContent = weekLabels[week];
    document.getElementById('checkout-text').value = '';
    renderEntries();
  }

  function addPrompt(text) {
    const ta = document.getElementById('checkout-text');
    const current = ta.value.trim();
    ta.value = current ? current + '\n' + text : text;
    ta.focus();
  }

  function saveEntry() {
    const text = document.getElementById('checkout-text').value.trim();
    if (!text) return;

    const store = getStore();
    if (!store[currentWeek]) store[currentWeek] = [];

    // Get current EAT time for display
    const now = new Date();
    const eatOptions = { timeZone: 'Africa/Nairobi', day: 'numeric', month: 'short', weekday: 'short', hour: '2-digit', minute: '2-digit' };
    const timestamp = now.toLocaleString('en-GB', eatOptions) + ' EAT';

    store[currentWeek].unshift({ id: Date.now(), text, timestamp });
    setStore(store);
    document.getElementById('checkout-text').value = '';
    renderEntries();
  }

  function deleteEntry(id) {
    const store = getStore();
    if (store[currentWeek]) {
      store[currentWeek] = store[currentWeek].filter(e => e.id !== id);
    }
    setStore(store);
    renderEntries();
  }

  function renderEntries() {
    const store = getStore();
    const entries = store[currentWeek] || [];
    const container = document.getElementById('saved-entries');

    if (entries.length === 0) {
      container.innerHTML = `
        <div class="empty-state">
          <div class="big">🌱</div>
          Nothing logged yet for this week — come back at the end of your first day and write one thing, however small.
        </div>`;
      return;
    }

    container.innerHTML = entries.map(e => `
      <div class="saved-entry">
        <div class="saved-entry-meta">${e.timestamp}</div>
        <div class="saved-entry-text">${e.text.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>
        <button class="delete-entry" onclick="deleteEntry(${e.id})" title="Remove">×</button>
      </div>
    `).join('');
  }

